# Copy this file to ".env" and fill it in.  NEVER commit your real .env (it's git-ignored).

# ===== Telegram =====
# Create a bot with @BotFather and paste its token here (see README -> Setup).
TELEGRAM_TOKEN=

# ===== Mode =====
# text  -> text chat only (lightest; great for free 24/7 hosting)
# voice -> voice notes in/out (needs requirements-voice.txt; best on a local GPU)
# auto  -> voice if an NVIDIA GPU is detected, else text
BOT_MODE=text

# ===== LLM backend =====
# openai -> any OpenAI-compatible API (LM Studio local, or Groq/OpenRouter hosted)
# ollama -> local Ollama daemon
LLM_BACKEND=openai

# -- Local LLM via LM Studio (OpenAI-compatible server on :1234) --
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=qwen/qwen3-vl-4b
# -- OR a free hosted tier, e.g. Groq (get a key at https://console.groq.com) --
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-key
# OPENAI_MODEL=llama-3.3-70b-versatile

# Generation controls (generous max_tokens; low temperature for grounded-QA fidelity)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# -- Alt local backend: Ollama --
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2

# ===== Voice mode only (pip install -r requirements-voice.txt) =====
# STT runs on CPU by default; set WHISPER_DEVICE=cuda (+ CUDA DLLs) to use an NVIDIA GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
TTS_BACKEND=edge
TTS_VOICE_ES=es-ES-ElviraNeural
TTS_VOICE_EN=en-US-AriaNeural

# ===== Identity & data files =====
ASSISTANT_NAME=Your Name
PROFILE_PATH=profile/profile.md
PROJECTS_PATH=profile/projects.yaml
KNOWLEDGE_PATH=profile/knowledge.md
CV_DIR=cv
I18N_DIR=content/i18n
BOT_LANG=en

# Owner-only training commands (/aprende, /reload). Your numeric Telegram id(s),
# comma-separated. Empty = anyone (ok while setting up). Send /whoami to the bot to get yours.
ADMIN_USER_IDS=

# ===== Contact (the /contacto buttons) — leave blank to hide a button =====
CONTACT_EMAIL=you@example.com
CONTACT_PHONE=+00 000 000 000
CONTACT_WHATSAPP=00000000000
CONTACT_LINKEDIN=https://www.linkedin.com/in/yourhandle
CONTACT_GITHUB=https://github.com/yourhandle
CONTACT_TELEGRAM=yourhandle
